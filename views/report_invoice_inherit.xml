<odoo>
  <template id="report_invoice_custom" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@t-call='web.external_layout']" position="replace">
      <t t-call="web.external_layout">
        <t t-foreach="docs" t-as="o">

          <div class="page" style="font-family:'Arial'; font-size:14px; color:#000;">

            <!-- ===== HEADER ===== -->
            <div style="background-color:#213a5c; color:white; padding:25px 30px; border-radius:8px 8px 0 0;">

              <!-- ===== TOP ROW: LOGO + COMPANY NAMES ===== -->
              <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">

                <!-- LEFT SIDE (Logo + English Name) -->
                <div style="display:flex; align-items:center; flex:1;">
                  <!-- Company Logo -->
                  <div style="height:60px; width:80px; background-color:white; border-radius:6px; text-align:center; line-height:60px; margin-right:15px;">
                    <img t-att-src="'data:image/png;base64,%s' % (o.company_id.logo.decode() if o.company_id.logo else '')"
                         style="max-height:60px; max-width:80px;" alt="Company Logo"/>
                  </div>

                  <!-- English Company Name -->
                  <h2 style="margin:0; font-size:22px;" t-esc="o.company_id.name"/>
                </div>

                <!-- RIGHT SIDE (Arabic Company Name) -->
                <div style="text-align:right; flex:1;">
                  <h2 style="margin:0; font-size:22px;" t-esc="o.شركة التجارة العالمية"/>
                </div>
              </div>

              <!-- ===== INVOICE TITLE + NUMBER ===== -->
              <div style="display:flex; justify-content:space-between; margin-top:8px;">
                <span style="font-size:18px;">Invoice</span>
                <span style="font-size:18px;">فاتورة</span>
              </div>
              <div style="text-align:center; margin-top:5px; font-size:16px;">
                <span>INV-<span t-esc="o.name"/></span>
              </div>

              <!-- ===== COMPANY INFO TABLE (EN + AR) ===== -->
              <div style="display:flex; justify-content:space-between; margin-top:25px; border-bottom:1px solid white; padding-bottom:10px;">

                <!-- LEFT SIDE (English Info) -->
                <table style="color:white; font-size:15px;">
                  <tr>
                    <td style="padding-right:8px;"><strong>CR No:</strong></td>
                    <td><span t-esc="o.company_id.company_registry or ''"/></td>
                  </tr>
                  <tr>
                    <td style="padding-right:8px;"><strong>VAT No:</strong></td>
                    <td><span t-esc="o.company_id.vat or ''"/></td>
                  </tr>
                  <tr>
                    <td style="padding-right:8px;"><strong>Tel:</strong></td>
                    <td><span t-esc="o.company_id.phone or ''"/></td>
                  </tr>
                </table>

                <!-- RIGHT SIDE (Arabic Info) -->
                <table style="color:white; font-size:15px; text-align:right;">
                  <tr>
                    <td><strong>السجل التجاري:</strong></td>
                    <td><span t-esc="o.company_id.company_registry or ''"/></td>
                  </tr>
                  <tr>
                    <td><strong>الرقم الضريبي:</strong></td>
                    <td><span t-esc="o.company_id.vat or ''"/></td>
                  </tr>
                  <tr>
                    <td><strong>هاتف:</strong></td>
                    <td><span t-esc="o.company_id.phone or ''"/></td>
                  </tr>
                </table>
              </div>
            </div>

            <!-- ===== LINE ITEMS ===== -->
            <div style="padding:20px;">
              <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:15px;">
                <thead style="background:#213a5c; color:white;">
                  <tr>
                    <th style="padding:8px; text-align:left;">Description</th>
                    <th style="padding:8px; text-align:center;">Qty</th>
                    <th style="padding:8px; text-align:center;">Unit Price</th>
                    <th style="padding:8px; text-align:right;">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="o.invoice_line_ids" t-as="line">
                    <tr>
                      <td style="padding:8px;"><span t-esc="line.name"/></td>
                      <td style="padding:8px; text-align:center;"><span t-esc="line.quantity"/></td>
                      <td style="padding:8px; text-align:center;"><span t-esc="line.price_unit"/></td>
                      <td style="padding:8px; text-align:right;"><span t-esc="line.price_subtotal"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- ===== TOTALS ===== -->
            <div style="padding:10px 25px; text-align:right; font-size:16px;">
              <p><strong>Subtotal:</strong> <span t-esc="o.amount_untaxed"/></p>
              <p><strong>Tax:</strong> <span t-esc="o.amount_tax"/></p>
              <h3 style="margin-top:10px;"><strong>Total:</strong> <span t-esc="o.amount_total"/></h3>
            </div>

            <!-- ===== FOOTER ===== -->
            <div style="background-color:#1e2b35; color:white; padding:10px 20px; text-align:center; font-size:15px; border-radius:0 0 8px 8px;">
              <p style="margin:0;">Thank you for your business | شكراً لتعاملكم معنا</p>
            </div>

          </div>
        </t>
      </t>
    </xpath>
  </template>
</odoo>
