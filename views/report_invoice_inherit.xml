<odoo>
  <template id="report_invoice_custom" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@t-call='web.external_layout']" position="replace">
      <t t-call="web.external_layout">
        <t t-foreach="docs" t-as="o">

          <div class="page" style="font-family:'Arial'; font-size:14px; color:#000;">

            <!-- ===== HEADER SECTION ===== -->
            <div style="background-color:#213a5c; color:white; padding:25px 30px; border-radius:8px 8px 0 0;">
              <table style="width:100%; border-collapse:collapse;">
                <tr valign="top">
                  <!-- ===== LEFT SIDE: LOGO + COMPANY NAMES ===== -->
                  <td style="width:60%; vertical-align:top;">
                    <table style="width:100%;">
                      <tr>
                        <td style="width:80px; vertical-align:top;">
                          <img t-att-src="'data:image/png;base64,%s' % (o.company_id.logo.decode() if o.company_id.logo else '')"
                               style="height:65px; width:auto; border-radius:6px; background:white; padding:5px;" alt="Company Logo"/>
                        </td>
                        <td style="padding-left:10px; vertical-align:top;">
                          <h2 style="margin:0; font-size:22px;" t-esc="o.company_id.name"/>
                          <p style="margin:0; font-size:20px;">شركة التجارة العالمية</p>
                        </td>
                      </tr>
                    </table>
                  </td>

                  <!-- ===== RIGHT SIDE: INVOICE INFO ===== -->
                  <td style="width:40%; text-align:right; vertical-align:top;">
                    <h3 style="margin:0; font-size:22px;">فاتورة / Invoice</h3>
                    <p style="margin:5px 0 0 0; font-size:16px;">
                      INV-<span t-esc="o.name"/> / الفاتورة رقم <span t-esc="o.name"/>
                    </p>
                  </td>
                </tr>
              </table>
            </div>

            <!-- ===== COMPANY INFO SECTION ===== -->
            <div style="width:100%; margin-top:20px; display:flex; justify-content:space-between; gap:10px;">

              <!-- ===== LEFT DIV (English) ===== -->
              <div style="width:48%; background-color:#213a5c; color:white; padding:10px; border-radius:6px;">
                <h4 style="margin:0; font-size:15px; font-weight:bold;">Company Information</h4>
                <div style="border-bottom:2px solid white; margin:5px 0;"></div>
                <table style="width:100%; border-collapse:collapse; color:white; font-size:14px;">
                  <tr>
                    <td>
