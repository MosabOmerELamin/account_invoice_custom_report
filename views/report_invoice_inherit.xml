<odoo>
  <template id="report_invoice_custom" inherit_id="account.report_invoice_document">
    <xpath expr="." position="replace">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">

          <div class="page" style="font-family:'Arial'; border-radius:10px; overflow:hidden;">

            <!-- ===== HEADER SECTION ===== -->
            <div style="background-color:#213a5c; color:white; padding:25px 30px;">

              <!-- Top: Logo + Names + Invoice Title -->
              <div style="display:flex; justify-content:space-between; align-items:center;">

                <!-- LEFT: Logo and Company Names -->
                <div style="flex:1;">
                  <div style="height:60px; width:160px; background-color:white; border-radius:6px; text-align:center; line-height:60px; color:#213a5c; font-weight:bold;">
                    <img t-att-src="'data:image/png;base64,%s' % (o.company_id.logo.decode() if o.company_id.logo else '')" 
                         style="max-height:60px; max-width:160px;" alt="Company Logo"/>
                  </div>
                  <h2 style="margin:8px 0 0 0; font-size:22px;">Global Trading Co.</h2>
                  <p style="margin:0; font-size:18px;">شركة التجارة العالمية</p>
                </div>

                <!-- RIGHT: Invoice Title -->
                <div style="text-align:right;">
                  <h3 style="margin:0; font-size:26px;">فاتورة / Invoice</h3>
                  <p style="margin:5px 0 0 0; font-size:18px;">INV-<span t-esc="o.name"/></p>
                </div>
              </div>

              <!-- Bottom: Company Info (Two Tables: EN + AR) -->
              <div style="display:flex; justify-content:space-between; margin-top:20px; border-bottom:1px solid white; padding-bottom:10px;">
                <!-- LEFT SIDE (ENGLISH INFO) -->
                <table style="color:white; font-size:15px;">
                  <tr><td><strong>CR No:</strong></td><td><span t-esc="o.company_id.company_registry or ''"/></td></tr>
                  <tr><td><strong>VAT No:</strong></td><td><span t-esc="o.company_id.vat or ''"/></td></tr>
                  <tr><td><strong>Tel:</strong></td><td><span t-esc="o.company_id.phone or ''"/></td></tr>
                </table>

                <!-- RIGHT SIDE (ARABIC INFO) -->
                <table style="color:white; font-size:15px; text-align:right;">
                  <tr><td><strong>السجل التجاري:</strong></td><td><span t-esc="o.company_id.company_registry or ''"/></td></tr>
                  <tr><td><strong>الرقم الضريبي:</strong></td><td><span t-esc="o.company_id.vat or ''"/></td></tr>
                  <tr><td><strong>هاتف:</strong></td><td><span t-esc="o.company_id.phone or ''"/></td></tr>
                </table>
              </div>

            </div>
            <!-- ===== END HEADER ===== -->


            <!-- ===== INVOICE LINES ===== -->
            <div style="padding:20px;">
              <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:15px;">
                <thead style="background:#213a5c; color:white;">
                  <tr>
                    <th style="padding:8px; text-align:left;">Description</th>
                    <th style="padding:8px; text-align:center;">Qty</th>
                    <th style="padding:8px; text-align:center;">Unit Price</th>
                    <th style="padding:8px; text-align:right;">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="o.invoice_line_ids" t-as="line">
                    <tr>
                      <td style="padding:8px;"><span t-esc="line.name"/></td>
                      <td style="padding:8px; text-align:center;"><span t-esc="line.quantity"/></td>
                      <td style="padding:8px; text-align:center;"><span t-esc="line.price_unit"/></td>
                      <td style="padding:8px; text-align:right;"><span t-esc="line.price_subtotal"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- ===== TOTALS ===== -->
            <div style="padding:10px 25px; text-align:right; font-size:16px;">
              <p><strong>Subtotal:</strong> <span t-esc="o.amount_untaxed"/></p>
              <p><strong>Tax:</strong> <span t-esc="o.amount_tax"/></p>
              <h3><strong>Total:</strong> <span t-esc="o.amount_total"/></h3>
            </div>

            <!-- ===== FOOTER ===== -->
            <div style="background-color:#1e2b35; color:white; padding:10px 20px; text-align:center; font-size:15px;">
              <p>Thank you for your business | شكراً لتعاملكم معنا</p>
            </div>

          </div>
        </t>
      </t>
    </xpath>
  </template>
</odoo>
