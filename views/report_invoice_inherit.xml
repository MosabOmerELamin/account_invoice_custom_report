<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="." position="replace">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-family: 'Arial', sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;">

                        <!-- HEADER - Clean and professional -->
                        <div style="text-align: center; margin-bottom: 25px;">
                            <h1 style="color: #2E86AB; margin: 0 0 8px 0; font-size: 28px; font-weight: bold;">فاتورة / Invoice</h1>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin: 10px 0;">
                                <span style="font-weight: bold; font-size: 16px;">Invoice Number: <span t-field="o.name"/></span>
                                <span style="font-weight: bold; font-size: 16px; direction: rtl;">فاتورة رقم: <span t-field="o.name"/></span>
                            </div>
                            <hr style="border-top: 2px solid #2E86AB; margin: 15px 0;"/>
                        </div>

                        <!-- COMPANY INFORMATION - Bilingual -->
                        <div style="margin-bottom: 25px;">
                            <!-- English Company Info -->
                            <div style="margin-bottom: 20px;">
                                <h3 style="color: #2E86AB; border-bottom: 1px solid #2E86AB; padding-bottom: 5px; margin-bottom: 10px;">Company Information</h3>
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 4px 0; width: 80px; font-weight: bold;">CR No:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.company_registry" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 0; font-weight: bold;">VAT No:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.vat" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 0; font-weight: bold;">Tel:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.phone" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Arabic Company Info -->
                            <div style="direction: rtl; text-align: right;">
                                <h3 style="color: #2E86AB; border-bottom: 1px solid #2E86AB; padding-bottom: 5px; margin-bottom: 10px;">معلومات الشركة</h3>
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 4px 0; width: 100px; font-weight: bold;">السجل التجاري:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.company_registry" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 0; font-weight: bold;">الرقم الضريبي:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.vat" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 0; font-weight: bold;">هاتف:</td>
                                        <td style="padding: 4px 0;">
                                            <span t-field="o.company_id.phone" t-options='{"widget": "text"}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <hr style="border-top: 1px solid #ddd; margin: 20px 0;"/>

                        <!-- INVOICE CONTENT HEADER -->
                        <div style="margin-bottom: 20px;">
                            <div style="margin-bottom: 10px;">
                                <h3 style="color: #2E86AB; margin-bottom: 5px;">Invoice Content Area</h3>
                                <p style="color: #666; font-style: italic; margin: 0;">Add your line items, totals, and other details here.</p>
                            </div>
                            <div style="direction: rtl; text-align: right;">
                                <h3 style="color: #2E86AB; margin-bottom: 5px;">منطقة محتوى الفاتورة</h3>
                                <p style="color: #666; font-style: italic; margin: 0;">أضف بنودك وإجمالياتك وتفاصيل أخرى هنا.</p>
                            </div>
                        </div>

                        <!-- CUSTOMER INFORMATION -->
                        <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 5px;">
                            <div style="display: flex; justify-content: space-between;">
                                <!-- English Customer Info -->
                                <div style="flex: 1;">
                                    <h4 style="color: #2E86AB; margin-bottom: 8px;">Customer Information</h4>
                                    <p style="margin: 4px 0;"><strong>Name:</strong> <span t-field="o.partner_id.name"/></p>
                                    <p style="margin: 4px 0;"><strong>Address:</strong> 
                                        <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/>, </t>
                                        <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, </t>
                                        <t t-if="o.partner_id.state_id"><span t-field="o.partner_id.state_id.name"/>, </t>
                                        <t t-if="o.partner_id.zip"><span t-field="o.partner_id.zip"/>, </t>
                                        <t t-if="o.partner_id.country_id"><span t-field="o.partner_id.country_id.name"/></t>
                                    </p>
                                    <t t-if="o.partner_id.vat">
                                        <p style="margin: 4px 0;"><strong>Tax ID:</strong> <span t-field="o.partner_id.vat"/></p>
                                    </t>
                                </div>
                                
                                <!-- Arabic Customer Info -->
                                <div style="flex: 1; direction: rtl; text-align: right;">
                                    <h4 style="color: #2E86AB; margin-bottom: 8px;">معلومات العميل</h4>
                                    <p style="margin: 4px 0;"><strong>الاسم:</strong> <span t-field="o.partner_id.name"/></p>
                                    <p style="margin: 4px 0;"><strong>العنوان:</strong> 
                                        <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/>, </t>
                                        <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, </t>
                                        <t t-if="o.partner_id.state_id"><span t-field="o.partner_id.state_id.name"/>, </t>
                                        <t t-if="o.partner_id.zip"><span t-field="o.partner_id.zip"/>, </t>
                                        <t t-if="o.partner_id.country_id"><span t-field="o.partner_id.country_id.name"/></t>
                                    </p>
                                    <t t-if="o.partner_id.vat">
                                        <p style="margin: 4px 0;"><strong>الرقم الضريبي:</strong> <span t-field="o.partner_id.vat"/></p>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- LINE ITEMS TABLE -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;">
                            <thead>
                                <tr style="background-color: #2E86AB; color: white;">
                                    <th style="padding: 10px; text-align: left; border: 1px solid #2E86AB;">Description</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2E86AB; width: 60px;">Qty</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2E86AB; width: 90px;">Unit Price</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #2E86AB; width: 100px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS -->
                        <div style="text-align: right; margin-bottom: 25px;">
                            <div style="display: inline-block; text-align: left;">
                                <p style="margin: 6px 0; font-size: 14px;">
                                    <strong>Subtotal:</strong> 
                                    <span style="margin-left: 15px; min-width: 100px; display: inline-block; text-align: right;">
                                        <span t-field="o.amount_untaxed"/>
                                    </span>
                                </p>
                                <p style="margin: 6px 0; font-size: 14px;">
                                    <strong>Tax:</strong> 
                                    <span style="margin-left: 15px; min-width: 100px; display: inline-block; text-align: right;">
                                        <span t-field="o.amount_tax"/>
                                    </span>
                                </p>
                                <p style="margin: 8px 0; font-size: 16px; border-top: 1px solid #2E86AB; padding-top: 6px;">
                                    <strong>Total:</strong> 
                                    <span style="margin-left: 15px; min-width: 100px; display: inline-block; text-align: right;">
                                        <span t-field="o.amount_total"/>
                                    </span>
                                </p>
                            </div>
                        </div>

                        <hr style="border-top: 2px solid #2E86AB; margin: 25px 0;"/>

                        <!-- FOOTER -->
                        <div style="text-align: center; padding: 15px 0;">
                            <div style="margin-bottom: 8px;">
                                <p style="margin: 0; font-weight: bold; font-size: 14px;">
                                    Thank you for your business! Contact: 
                                    <span t-field="o.company_id.email"/> | <span t-field="o.company_id.phone"/>
                                </p>
                            </div>
                            <div style="direction: rtl;">
                                <p style="margin: 0; font-weight: bold; font-size: 14px;">
                                    شكراً لتعاملكم! 
                                    <span t-field="o.company_id.email"/> | <span t-field="o.company_id.phone"/> :اتصال
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
