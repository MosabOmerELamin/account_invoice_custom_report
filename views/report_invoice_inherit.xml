<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        
        <!-- Replace the entire header section -->
        <xpath expr="//div[hasclass('header')]" position="replace">
            <div class="header" style="text-align: center; margin-bottom: 20px; padding-bottom: 15px;">
                <h1 style="color: #2E86AB; margin: 0; font-size: 24px;">فاتورة / Invoice</h1>
                <div style="display: flex; justify-content: space-between; margin-top: 10px; align-items: center;">
                    <span style="font-weight: bold;">Invoice Number: <span t-field="o.name"/></span>
                    <span style="direction: rtl; font-weight: bold;">فاتورة رقم: <span t-field="o.name"/></span>
                </div>
                <hr style="border-top: 2px solid #2E86AB; margin: 10px 0;"/>
            </div>
        </xpath>

        <!-- Add bilingual company information at the beginning -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <!-- Company Information Section -->
            <div class="row mb-4" style="border: 1px solid #e0e0e0; border-radius: 5px; padding: 15px; background-color: #f9f9f9; margin-bottom: 20px !important;">
                <!-- English Company Info -->
                <div class="col-6">
                    <h3 style="color: #2E86AB; border-bottom: 1px solid #2E86AB; padding-bottom: 5px; margin-bottom: 10px;">Company Information</h3>
                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 2px 5px; width: 30%;"><strong>CR No:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.company_registry"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 2px 5px;"><strong>VAT No:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.vat"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 2px 5px;"><strong>Tel:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.phone"/></td>
                        </tr>
                    </table>
                </div>
                
                <!-- Arabic Company Info -->
                <div class="col-6" style="direction: rtl; text-align: right;">
                    <h3 style="color: #2E86AB; border-bottom: 1px solid #2E86AB; padding-bottom: 5px; margin-bottom: 10px;">معلومات الشركة</h3>
                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 2px 5px; width: 30%;"><strong>هاتف:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.phone"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 2px 5px;"><strong>الرقم الضريبي:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.vat"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 2px 5px;"><strong>السجل التجاري:</strong></td>
                            <td style="padding: 2px 5px;"><span t-field="o.company_id.company_registry"/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Invoice Content Header -->
            <div class="row mb-3">
                <div class="col-12">
                    <h3 style="color: #2E86AB; margin-bottom: 5px;">Invoice Content Area</h3>
                    <p style="color: #666; font-style: italic; margin-bottom: 15px;">Add your line items, totals, and other details here.</p>
                </div>
                <div class="col-12" style="direction: rtl; text-align: right;">
                    <h3 style="color: #2E86AB; margin-bottom: 5px;">منطقة محتوى الفاتورة</h3>
                    <p style="color: #666; font-style: italic; margin-bottom: 15px;">أضف بنودك وإجمالياتك وتفاصيل أخرى هنا.</p>
                </div>
            </div>
        </xpath>

        <!-- Modify customer address display to be bilingual -->
        <xpath expr="//div[hasclass('row')]//div[hasclass('col-6')]" position="attributes">
            <attribute name="t-attf-class">col-6 #{o.partner_shipping_id and (o.partner_shipping_id != o.partner_id) and 'border-end' or ''}</attribute>
        </xpath>

        <!-- Add Arabic customer info -->
        <xpath expr="//div[hasclass('row')]//div[hasclass('col-6')]" position="after">
            <div class="col-6" style="direction: rtl; text-align: right;">
                <strong class="d-block mt-3">العميل</strong>
                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <div t-if="o.partner_id.vat">
                    <strong>الرقم الضريبي:</strong> <span t-field="o.partner_id.vat"/>
                </div>
            </div>
        </xpath>

        <!-- Replace the footer section -->
        <xpath expr="//div[hasclass('footer')]" position="replace">
            <div class="footer" style="margin-top: 50px; padding-top: 20px; border-top: 2px solid #2E86AB; text-align: center;">
                <div style="margin-bottom: 10px;">
                    <p style="margin: 0; font-weight: bold;">Thank you for your business! Contact: <span t-field="o.company_id.email"/> | <span t-field="o.company_id.phone"/></p>
                </div>
                <div style="direction: rtl;">
                    <p style="margin: 0; font-weight: bold;">شكراً لتعاملكم! <span t-field="o.company_id.email"/> | <span t-field="o.company_id.phone"/> :اتصال</p>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
