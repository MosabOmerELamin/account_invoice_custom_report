<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
      <!-- Insert header inside the main page container (safer: match any div with class containing 'page') -->
      <xpath expr="//div[contains(@class,'page')]" position="inside">
        <div class="custom-invoice-header">
          <div class="custom-invoice-header-inner">
            <div class="left-block">
              <div class="logo-box">
                <t t-if="o.company_id.logo">
                  <img t-att-src="'data:image/png;base64,%s' % o.company_id.logo" class="company-logo"/>
                </t>
                <t t-if="not o.company_id.logo">
                  <div class="placeholder-logo">COMPANY<br/>LOGO</div>
                </t>
              </div>
              <div class="company-title">
                <h1><span t-field="o.company_id.name"/></h1>
                <div class="company-title-ar" t-esc="o.company_id.website or ''"/>
              </div>
            </div>
            <div class="right-block">
              <div class="invoice-title">
                <h2>Invoice / فاتورة</h2>
                <div class="invoice-number">
                  <span t-esc="'INV-' + (o.name or '')"/>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>

      <!-- Add custom class to footer if present -->
      <xpath expr="//div[contains(@class,'footer')]" position="attributes">
        <attribute name="class">footer custom-invoice-footer</attribute>
      </xpath>
    </template>
  </data>
</odoo>
