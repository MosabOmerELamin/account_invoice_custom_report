<div style="background-color:#213a5c; color:white; padding:25px 30px; border-radius:8px 8px 0 0;">
  <!-- Logo + Company Name -->
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="width:60%; vertical-align:top;">
        <table style="width:100%;">
          <tr>
            <td style="width:80px;">
              <img t-att-src="'data:image/png;base64,%s' % (o.company_id.logo.decode() if o.company_id.logo else '')"
                   style="height:65px; width:auto; border-radius:6px; background:white; padding:5px;"/>
            </td>
            <td style="padding-left:10px;">
              <h2 style="margin:0;" t-esc="o.company_id.name"/>
              <p style="margin:0;">شركة التجارة العالمية</p>
            </td>
          </tr>
        </table>
      </td>
      <td style="width:40%; text-align:right;">
        <h3 style="margin:0;">فاتورة / Invoice</h3>
        <p style="margin:5px 0 0 0;">
          INV-<span t-esc="o.name"/> / الفاتورة رقم <span t-esc="o.name"/>
        </p>
      </td>
    </tr>
  </table>

  <!-- Company Info Side by Side -->
  <div style="display:flex; flex-wrap:nowrap; justify-content:space-between; margin-top:20px; gap:10px;">
    
    <!-- LEFT (English) -->
    <div style="width:49%; background-color:#1e3d59; padding:10px; border-radius:6px;">
      <h4 style="margin:0; font-weight:bold;">Company Information</h4>
      <div style="border-bottom:2px solid white; margin:5px 0;"></div>
      <p style="margin:0;">
        <strong>CR No:</strong> <span t-esc="o.company_id.company_registry or ''"/><br/>
        <strong>VAT No:</strong> <span t-esc="o.company_id.vat or ''"/><br/>
        <strong>Tel:</strong> <span t-esc="o.company_id.phone or ''"/>
      </p>
    </div>

    <!-- RIGHT (Arabic) -->
    <div style="width:49%; background-color:#34495e; padding:10px; border-radius:6px; text-align:right;">
      <h4 style="margin:0; font-weight:bold;">معلومات الشركة</h4>
      <div style="border-bottom:2px solid white; margin:5px 0;"></div>
      <p style="margin:0;">
        <strong>السجل التجاري:</strong> <span t-esc="o.company_id.company_registry or ''"/><br/>
        <strong>الرقم الضريبي:</strong> <span t-esc="o.company_id.vat or ''"/><br/>
        <strong>هاتف:</strong> <span t-esc="o.company_id.phone or ''"/>
      </p>
    </div>

  </div>
</div>
